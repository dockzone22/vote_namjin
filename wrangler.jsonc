{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vote-namjin-review",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "namjin.kr",
      "custom_domain": true
    },
    {
      "pattern": "www.namjin.kr/*",
      "zone_name": "namjin.kr"
    }
  ],
  "assets": {
    "directory": "./dist/review-site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
